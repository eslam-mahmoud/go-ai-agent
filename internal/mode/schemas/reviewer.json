{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "question",
    "discoveries",
    "risks",
    "recommended_next_action",
    "acceptance_criteria_met",
    "blocking_findings",
    "future_improvements"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "needs_input", "blocked", "failed"]
    },
    "summary": {"type": "string", "minLength": 1},
    "question": {"type": ["string", "null"]},
    "discoveries": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "recommended_next_action": {"type": "string"},
    "acceptance_criteria_met": {"type": "boolean"},
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "severity"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          }
        }
      }
    },
    "future_improvements": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "needs_input"}}},
      "then": {"properties": {"question": {"type": "string", "minLength": 1}}},
      "else": {"properties": {"question": {"type": "null"}}}
    }
  ]
}
